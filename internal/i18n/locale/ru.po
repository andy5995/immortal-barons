#: cmd/immortal-barons/flags.go:84
msgid ""
"write BBSINFO.LST — every board, when it was last heard from, and the "
"version it runs, then exit"
msgstr ""
"записать BBSINFO.LST - все станции, когда о каждой слышали в последний раз и "
"какая у неё версия, затем выйти"

#: cmd/immortal-barons/flags.go:83
msgid ""
"write LASTPACKET.LST — when a packet from each other board was last "
"processed here, then exit"
msgstr ""
"записать LASTPACKET.LST - когда здесь в последний раз обработан пакет от "
"каждой другой станции, затем выйти"

#: cmd/immortal-barons/flags.go:85
msgid ""
"write PLAYERLIST.LST — every realm on every board (League Coordinator only), "
"then exit"
msgstr ""
"записать PLAYERLIST.LST - все державы на всех станциях (только координатор "
"лиги), затем выйти"

#: cmd/immortal-barons/flags.go:67
