msgstr "Verträge und Bündnisse"

#. type: Bullet: '- '
#: docs/playing.md:18
msgid "**Inter-BBS** — leagues and group attacks"
msgstr ""

#. type: Plain text
#: docs/playing.md:22
#, no-wrap
msgid ""
"The same content is the single source for a web guide too. It lives as Markdown\n"
"under `internal/help/content/<category>/`, and is translated with po4a (see\n"
